# Telegram — get token from @BotFather via /newbot
TELEGRAM_BOT_TOKEN=

# Hetzner Inference — free tier token via Hetzner Cloud Console > API
HETZNER_API_KEY=
HETZNER_BASE_URL=https://inference.hetzner.com/api/v1
LLM_PRIMARY_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
LLM_FALLBACK_MODEL=Qwen3.8-27B

# OpenCode — single key for Zen + Go via https://opencode.ai/auth
OPENCODE_API_KEY=
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_FREE_MODEL=mimo-v2.5-free
GO_BASE_URL=https://opencode.ai/zen/go/v1
GO_MODEL=mimo-v2.5
GO_ENABLED=1

# App tuning
MEMORY_BATCH_SIZE=50
MEMORY_TTL_HOURS=6
SUMMARIZE_DEFAULT=100
SUMMARIZE_CAP=500
ROUTER_FASTPATH=1
RATE_LIMIT_PER_60S=8
LLM_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO
DATA_DIR=/app/data
